@startuml
title Clinic System - Simple Class Diagram (6 patterns)
skinparam classAttributeIconSize 0
left to right direction

' ---- Layers (one repository shown as an example) ----
interface IAppointmentRepository {
  +create()
  +findOverlapping()
  +updateStatus()
}
class FirestoreAppointmentRepo
class AppointmentService {
  +book()
  +cancel()
  +reschedule()
}
IAppointmentRepository <|.. FirestoreAppointmentRepo
AppointmentService --> IAppointmentRepository

' ---- 1. Singleton ----
class FirestoreDB <<Singleton>> {
  +getDb()
}
FirestoreAppointmentRepo --> FirestoreDB

' ---- 2. Observer ----
class EventBus <<Observer>> {
  +on()
  +emit()
}
AppointmentService --> EventBus : emits events

' ---- 3. Factory Method ----
interface Notifier {
  +send()
}
class EmailNotifier
class SmsNotifier
class WhatsAppNotifier
class NotificationFactory <<Factory>> {
  +create(channel)
}
Notifier <|.. EmailNotifier
Notifier <|.. SmsNotifier
Notifier <|.. WhatsAppNotifier
NotificationFactory ..> Notifier : creates

' ---- 4. Strategy ----
interface DiscountStrategy {
  +calculate(fee)
}
class NoDiscount
class SeniorDiscount
class InsuranceDiscount
class StaffDiscount
DiscountStrategy <|.. NoDiscount
DiscountStrategy <|.. SeniorDiscount
DiscountStrategy <|.. InsuranceDiscount
DiscountStrategy <|.. StaffDiscount

' ---- 5. Adapter ----
interface PaymentGateway {
  +charge(amount, ref)
}
class BkashAdapter <<Adapter>>
class BkashClient
class FakeGateway
PaymentGateway <|.. BkashAdapter
PaymentGateway <|.. FakeGateway
BkashAdapter --> BkashClient : wraps

class BillingService {
  +createBillWithFee()
  +pay()
}
BillingService --> DiscountStrategy : uses
BillingService --> PaymentGateway : uses

' ---- 6. Facade ----
class BookingFacade <<Facade>> {
  +bookAndBill()
}
BookingFacade --> AppointmentService
BookingFacade --> BillingService
@enduml